# 在官方 带宽测试项目 的 sdkconfig 获得了不错的速度
# 在IDF中可以基于 带宽测试_sdkconfig 进行二次配置
# 在mpy中直接使用 带宽测试_sdkconfig 进行最后的增量覆盖配会与 mpy_sdkconfig 起冲突
# 最终参考 官方文档 与 带宽测试_sdkconfig 进行配置，损失了约 300~600 KiB 的速度
# https://docs.espressif.com/projects/esp-idf/zh_CN/latest/esp32s3/api-guides/wifi-driver/wifi-performance-and-power-save.html

# auto__AF
CONFIG_CAMERA_AF_SUPPORT=y
CONFIG_CAMERA_AF_DEFAULT_TIMEOUT_MS=2000

# ipv6
CONFIG_LWIP_IPV6=y 
CONFIG_LWIP_IPV6_AUTOCONFIG=y 
CONFIG_LWIP_IPV6_NUM_ADDRESSES=3

# S3_DEF
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
#CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
#CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
#CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# USB 控制台（关键：让 S3 像 C3 一样）
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT=

###################wifi配置###############################

# 发送主要配置,这要这两个似乎已经是最快了
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535


# 文档中直接提供的
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16 # 收
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64 # 收
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y  # 收
CONFIG_ESP_WIFI_RX_BA_WIN=32    # 收

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535 # 收
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64    # 收
#CONFIG_LWIP_UDP_RECVMBOX_SIZE=64    # UDP
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_WRAP=y



# 文档中推荐的
# SEND
#CONFIG_ESP_WIFI_TX_BUFFER # 动态缓冲区
#CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM
#CONFIG_LWIP_TCP_SND_BUF_DEFAULT

# READ
#CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM
#CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM
#CONFIG_ESP_WIFI_RX_BA_WIN
#CONFIG_LWIP_TCP_WND_DEFAULT

# IRAM
#CONFIG_ESP32S3_INSTRUCTION_CACHE_SIZE
#CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_SIZE
#CONFIG_ESP32S3_ICACHE_ASSOCIATED_WAYS
#CONFIG_ESP32S3_DATA_CACHE_SIZE
#CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE
#CONFIG_ESP32S3_DCACHE_ASSOCIATED_WAYS



# 其他配置
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1 # 动态发送缓冲区
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y   
#CONFIG_LWIP_IRAM_OPTIMIZATION=y # 据说双核没影响
#CONFIG_LWIP_MAX_SOCKETS    # 允许的套接字数量
#CONFIG_LWIP_MAX_ACTIVE_TCP # 允许的tcp连接数量